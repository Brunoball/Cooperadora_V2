# COOPERADORA V2 - Playwright (ejemplo)
PW_TARGET=local

PW_LOCAL_USER=TU_USUARIO_ADMIN_LOCAL
PW_LOCAL_PASSWORD=TU_PASSWORD_LOCAL

PW_HOSTINGER_USER=
PW_HOSTINGER_PASSWORD=

PW_LOCAL_BASE_URL=http://localhost:3000
PW_LOCAL_API_URL=http://localhost:3001/routes
PW_HOSTINGER_BASE_URL=https://cooperadora.ipet50.edu.ar
PW_HOSTINGER_API_URL=https://cooperadora.ipet50.edu.ar/api/routes

PW_START_FRONTEND=true
PW_START_BACKEND=true
PW_FRONTEND_COMMAND=npm start
PW_BACKEND_DIR=../backend
PW_PHP_COMMAND=php -c "C:\php\php.ini" -S localhost:3001

PW_E2E_HEADER=PLAYWRIGHT
PW_FINAL_CLEANUP=true
PW_VERIFY_INTEGRITY=true
PW_ALLOW_REMOTE_WRITES=false
