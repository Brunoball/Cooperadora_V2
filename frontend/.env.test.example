# COOPERADORA V2 - Playwright
# Ejecutar desde frontend con el MISMO comando para ambos entornos:
# npx playwright test --project=chromium --workers=1 --reporter=list
# Elegir UNA sola opción, y no cambiar REACT_APP_API_URL manualmente.
PW_TARGET=local
#PW_TARGET=hostinger
#PW_TARGET=hostinger-smoke

# Credenciales administrativas, privadas. No subir este archivo con valores reales.
PW_LOCAL_USER=USUARIO_ADMIN_LOCAL
PW_LOCAL_PASSWORD=CLAVE_ADMIN_LOCAL
PW_HOSTINGER_USER=USUARIO_ADMIN_HOSTINGER
PW_HOSTINGER_PASSWORD=CLAVE_ADMIN_HOSTINGER

# El React E2E siempre abre localhost:3000; sólo la API cambia de destino.
PW_LOCAL_BASE_URL=http://localhost:3000
PW_LOCAL_API_URL=http://localhost:3001/routes
PW_HOSTINGER_BASE_URL=https://cooperadora.ipet50.edu.ar
PW_HOSTINGER_API_URL=https://cooperadora.ipet50.edu.ar/api/routes

PW_START_FRONTEND=true
PW_START_BACKEND=true
PW_FRONTEND_COMMAND=npm start
PW_BACKEND_DIR=../backend
PW_PHP_COMMAND=php -c "C:\php\php.ini" -S localhost:3001

PW_E2E_HEADER=PLAYWRIGHT
PW_FINAL_CLEANUP=true
PW_VERIFY_INTEGRITY=true

# hostinger = pruebas CRUD completas contra DB REAL protegidas por preflight,
# namespace E2E, huella de integridad y limpieza. Primero desplegar el PHP
# adjunto y configurar E2E_PREFLIGHT_KEY con el MISMO secreto en api/.env remoto.
# No se permite poner una clave vacía ni saltarse el preflight.
PW_HOSTINGER_E2E_PREFLIGHT_KEY=COLOCAR_CLAVE_ALEATORIA_PRIVADA_DE_MINIMO_24_CARACTERES

# hostinger-smoke = sólo lecturas; no requiere la clave de preflight.
# hostinger-e2e = base remota AISLADA (configuración avanzada).
PW_HOSTINGER_MIN_REQUEST_INTERVAL_MS=300
PW_HOSTINGER_MAX_REQUEST_MS=45000
